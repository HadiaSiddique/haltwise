# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TAVILY_API_KEY=

# Optional: pin exact model IDs (otherwise resolved at startup from GET /models)
# MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_NANO=
# MODEL_OMNI=
# MODEL_ULTRA=

# "on" lets Nemotron reason before answering (slower). Default off for live demo latency.
NEMOTRON_THINKING=off

# HMAC secret used to sign genuine bank call/SMS notices (Call-Match)
NOTICE_SIGNING_SECRET=change-me
PORT=8787
